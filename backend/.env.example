DEBUG=true
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Optional comma-separated additional origins, each including http:// or https://
CSRF_TRUSTED_ORIGINS=
# Local SQLite:
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL:
DATABASE_URL=postgresql://pixelmint:pixelmint_password@localhost:5432/pixelmint

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SCOPES=read_products,write_products,read_files,write_files
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/auth/shopify/callback/
# Use true only for development stores. Test charges never generate real revenue.
SHOPIFY_BILLING_TEST_MODE=true

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5

# fal.ai product video generation
FAL_KEY=
# Replace with a long random value. fal.ai includes this in the completion webhook URL.
FAL_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Credits charged for each submitted video.
VIDEO_GENERATION_CREDITS=10
# Maximum number of selected product images used to create the OpenAI video prompt.
VIDEO_MAX_REFERENCES=5
# Maximum generated video download size in bytes (default: 200 MB).
VIDEO_MAX_FILE_SIZE=209715200

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
